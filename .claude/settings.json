{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pre-push-gate.ps1",
            "timeout": 600,
            "statusMessage": "Checking pre-push gate..."
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pre-push-gate.ps1",
            "timeout": 600,
            "statusMessage": "Checking pre-push gate..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/rate-limit-gate.ps1",
            "timeout": 15,
            "statusMessage": "Checking rate-limit gate before launching agent..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/session-start-autopilot.ps1",
            "timeout": 15,
            "statusMessage": "Arming autopilot..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/autopilot-gate.ps1",
            "timeout": 15,
            "statusMessage": "Checking autopilot gate..."
          }
        ]
      }
    ]
  }
}
