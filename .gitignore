# Secrets and local config
config.yaml
config.yaml.*

# Saved OPAL session cookies. config.PerInstallStateFile puts these in the
# config.yaml's own directory - which for this repo and every worktree of it
# is the checkout root - so the default path for a session is a file inside
# the working tree. Untracked and never committed: it is a live credential.
.opal_storage_state*.json

# Downloaded files and sync state
.downloads/
*.manifest.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# Go
/opal-downloader
*.exe
*.test
*.out
go.work
go.work.sum

# Installer build artifacts (staged Chromium cache + compiled setup.exe -
# both are local/generated, never checked in; see installer/opal-downloader.iss)
installer/chromium-cache/
installer/output/

# Local task queue
.claude/queue/
.claude/settings.local.json

# Codex CLI hook config, local tooling like .claude/ above
.codex/

# Scratch dumps from manual scraping/debug runs
tmp/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
